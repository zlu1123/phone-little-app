.compensation-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #eef3fb 0%, #f7f8fa 40%);
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* ========== 初始入口 ========== */
.entry-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.entry-card {
  width: 100%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 32rpx rgba(238, 10, 36, 0.08);
  animation: fadeIn 0.5s ease;
}

.entry-icon {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(
    135deg,
    rgba(238, 10, 36, 0.08) 0%,
    rgba(238, 10, 36, 0.12) 100%
  );
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.entry-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.entry-subtitle {
  font-size: 26rpx;
  color: #969799;
  margin-bottom: 48rpx;
}

/* ========== 搜索表单 ========== */
.search-section {
  padding: 20rpx;
}

.card-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  animation: fadeIn 0.5s ease;
}

.section-header {
  margin-bottom: 24rpx;
  border-left: 8rpx solid #1989fa;
  padding-left: 20rpx;
}

.section-header .title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.section-header .subtitle {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.search-btn {
  margin-top: 40rpx;
}

/* ========== 查询结果 ========== */
.result-section {
  padding: 20rpx;
}

.search-tag {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 24rpx;
  background: linear-gradient(135deg, #f0f7ff 0%, #e8f2ff 100%);
  border-radius: 12rpx;
  border: 1rpx solid rgba(25, 137, 250, 0.12);
}

.search-tag__text {
  font-size: 24rpx;
  color: #323233;
  line-height: 1.6;
  word-break: break-all;
}

.re-search-bar {
  display: flex;
  justify-content: flex-end;
  padding: 20rpx 0;
}

/* 订单列表 */
.order-list {
  margin-top: 8rpx;
}

.list-title {
  font-size: 26rpx;
  color: #969799;
  padding: 16rpx 8rpx;
  font-weight: 500;
}

.order-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.order-info {
  flex: 1;
  margin-right: 20rpx;
  overflow: hidden;
}

.order-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.order-detail {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  line-height: 1.5;
}

.order-detail .detail-label {
  color: #969799;
  flex-shrink: 0;
}

.order-detail .detail-value {
  color: #323233;
  word-break: break-all;
}

.order-action {
  flex-shrink: 0;
}

/* 空态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0 60rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #c8c9cc;
  margin-top: 20rpx;
}

/* ========== 动画 ========== */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
