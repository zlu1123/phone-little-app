.review-page {
  min-height: 100vh;
  background: #f7f8fa;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* 列表头部 */
.list-header {
  padding: 16rpx 32rpx 4rpx;
}

.list-count {
  font-size: 24rpx;
  color: #969799;
}

/* 列表项 label 区域 */
.cell-label {
  margin-top: 4rpx;
}

.cell-label__row {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #646566;
  line-height: 1.8;
}

/* 操作按钮区 */
.cell-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 0 32rpx 20rpx;
  background: #fff;
}

/* 弹窗内容 */
.dialog-body {
  padding: 0 24rpx;
}

/* 加载更多 */
.loading-more {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}
