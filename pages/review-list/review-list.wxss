.review-page {
  min-height: 100vh;
  background: #f7f8fa;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.loading-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

/* 列表头部 */
.list-header {
  padding: 20rpx 32rpx 8rpx;
}

.list-count {
  font-size: 24rpx;
  color: #969799;
}

/* 订单列表 */
.review-list {
  padding: 0 20rpx;
}

.review-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  animation: fadeIn 0.4s ease;
}

.review-item__info {
  flex: 1;
  margin-right: 24rpx;
  overflow: hidden;
}

.review-item__name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 10rpx;
}

.review-item__detail {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  line-height: 1.6;
}

.review-item__detail .label {
  color: #969799;
  flex-shrink: 0;
}

.review-item__detail .value {
  color: #323233;
  word-break: break-all;
}

.review-item__actions {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 空态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0 60rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #c8c9cc;
  margin-top: 20rpx;
}

/* 加载更多 */
.loading-more {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 金额输入弹窗 */
.amount-dialog-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.amount-dialog {
  width: 560rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 48rpx 40rpx 36rpx;
  box-sizing: border-box;
}

.amount-dialog__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  text-align: center;
  margin-bottom: 36rpx;
}

.amount-dialog__input-wrap {
  display: flex;
  align-items: center;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  height: 88rpx;
  margin-bottom: 40rpx;
}

.amount-dialog__prefix {
  font-size: 36rpx;
  font-weight: 600;
  color: #1989fa;
  margin-right: 12rpx;
}

.amount-dialog__input {
  flex: 1;
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
  height: 100%;
}

.amount-dialog__actions {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
}

.amount-dialog__actions .van-button {
  flex: 1;
}

/* 驳回原因输入框 */
.reject-reason__input-wrap {
  display: flex;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 40rpx;
  min-height: 180rpx;
}

.reject-reason__textarea {
  width: 100%;
  min-height: 160rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  box-sizing: border-box;
  line-height: 1.6;
}
