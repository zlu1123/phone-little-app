.review-page {
  min-height: 100vh;
  background: #f7f8fa;
  /* 底部内边距由 wxml 内联样式动态设置：calc(20px + bottomSafe) */
}

/* 列表头部 */
.list-header {
  padding: 16rpx 32rpx 4rpx;
}

.list-count {
  font-size: 24rpx;
  color: #969799;
}

/* 每条订单独立卡片：卡片之间留出间隔 */
.order-card {
  margin-bottom: 5px;
}

/* 列表项 label 区域 */
.cell-label {
  margin-top: 4rpx;
}

.cell-label__row {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #646566;
  line-height: 1.8;
}

/* 操作按钮区（位于所属订单卡片底部） */
.cell-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 16rpx 32rpx 20rpx;
  background: #fff;
}

/* 弹窗内容 */
.dialog-body {
  padding: 0 24rpx;
}

/* 加载更多 */
.loading-more {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}
