<view class="review-page">
  <van-nav-bar
    title="待审核列表"
    fixed="{{true}}"
    placeholder="{{true}}"
    z-index="{{100}}"
    left-arrow
    bind:click-left="handleBack"
  ></van-nav-bar>

  <!-- 骨架屏加载态 -->
  <van-skeleton title row="3" loading="{{ isLoading }}" animate>
    <!-- 列表内容 -->
    <block wx:if="{{ orderList.length > 0 }}">
      <view class="list-header">
        <view class="list-count">共 {{ total }} 条待审核订单</view>
      </view>

      <van-cell-group inset>
        <block wx:for="{{ orderList }}" wx:key="id">
          <van-cell
            title="{{ item.name }}"
            use-label-slot
            custom-style="padding-bottom: 0;"
          >
            <view slot="label" class="cell-label">
              <view wx:if="{{ item.orderId }}" class="cell-label__row">
                <van-icon name="orders-o" size="14" color="#969799" custom-style="margin-right: 8rpx;" />
                <text>订单ID：{{ item.orderId }}</text>
              </view>
              <view wx:if="{{ item.infoId }}" class="cell-label__row">
                <van-icon name="contact-o" size="14" color="#969799" custom-style="margin-right: 8rpx;" />
                <text>留资ID：{{ item.infoId }}</text>
              </view>
              <view wx:if="{{ item.signatureImei }}" class="cell-label__row">
                <van-icon name="label-o" size="14" color="#969799" custom-style="margin-right: 8rpx;" />
                <text>签约IMEI：{{ item.signatureImei }}</text>
              </view>
              <view wx:if="{{ item.phoneNum }}" class="cell-label__row">
                <van-icon name="phone-o" size="14" color="#969799" custom-style="margin-right: 8rpx;" />
                <text>手机号：{{ item.phoneNum }}</text>
              </view>
              <view wx:if="{{ item.remark }}" class="cell-label__row">
                <van-icon name="comment-o" size="14" color="#969799" custom-style="margin-right: 8rpx;" />
                <text>备注：{{ item.remark }}</text>
              </view>
              <view wx:if="{{ item.createTime }}" class="cell-label__row">
                <van-icon name="clock-o" size="14" color="#969799" custom-style="margin-right: 8rpx;" />
                <text>{{ item.createTime }}</text>
              </view>
            </view>
          </van-cell>

          <!-- 操作按钮 -->
          <view class="cell-actions">
            <van-button
              size="small"
              round
              type="danger"
              plain
              hairline
              loading="{{ isOperating }}"
              data-index="{{ index }}"
              data-action="reject"
              bind:click="handleReview"
            >
              驳回
            </van-button>
            <van-button
              size="small"
              round
              type="primary"
              hairline
              loading="{{ isOperating }}"
              data-index="{{ index }}"
              data-action="approve"
              bind:click="handleReview"
            >
              通过
            </van-button>
          </view>
        </block>
      </van-cell-group>
    </block>

    <!-- 空态 -->
    <van-empty
      wx:elif="{{ !isLoading }}"
      image="search"
      description="暂无待审核订单"
    />
  </van-skeleton>

  <!-- 加载更多 -->
  <view wx:if="{{ loadingMore }}" class="loading-more">
    <van-loading type="spinner" color="#1989fa" size="16px">加载更多...</van-loading>
  </view>

  <!-- 金额输入弹窗 -->
  <van-dialog
    use-slot
    show="{{ showAmountDialog }}"
    title="请输入赔付金额（选填）"
    show-cancel-button
    confirm-button-text="确定"
    before-close="{{ beforeAmountClose }}"
    bind:close="onAmountDialogClosed"
    bind:cancel="handleCloseAmountDialog"
  >
    <view class="dialog-body">
      <van-field
        value="{{ amountInput }}"
        placeholder="0.00"
        type="digit"
        label="¥"
        input-align="left"
        border="{{ true }}"
        custom-style="background: #f7f8fa; border-radius: 8rpx; padding: 12rpx 16rpx;"
        bind:change="handleAmountInput"
      />
    </view>
  </van-dialog>

  <!-- 驳回原因输入弹窗 -->
  <van-dialog
    use-slot
    show="{{ showRejectDialog }}"
    title="请填写驳回原因"
    show-cancel-button
    confirm-button-text="确定驳回"
    before-close="{{ beforeRejectClose }}"
    bind:close="onRejectDialogClosed"
    bind:cancel="handleCloseRejectDialog"
  >
    <view class="dialog-body">
      <van-field
        value="{{ rejectReasonInput }}"
        placeholder="请输入驳回原因"
        type="textarea"
        autosize="{{ true }}"
        maxlength="200"
        border="{{ true }}"
        custom-style="background: #f7f8fa; border-radius: 8rpx; padding: 12rpx 16rpx;"
        bind:change="handleRejectReasonInput"
      />
    </view>
  </van-dialog>

  <van-toast id="van-toast" />
</view>
