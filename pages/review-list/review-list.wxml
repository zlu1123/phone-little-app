<view class="review-page">
  <van-nav-bar
    title="待审核列表"
    fixed="{{true}}"
    placeholder="{{true}}"
    z-index="{{100}}"
    left-arrow
    bind:click-left="handleBack"
  ></van-nav-bar>

  <!-- 加载中 -->
  <view wx:if="{{ isLoading }}" class="loading-wrapper">
    <van-loading type="spinner" color="#1989fa" size="24px">加载中...</van-loading>
  </view>

  <!-- 订单列表 -->
  <block wx:else>
    <view wx:if="{{ orderList.length > 0 }}" class="review-list">
      <view class="list-header">
        <text class="list-count">共 {{ total }} 条待审核订单</text>
      </view>

      <view
        wx:for="{{ orderList }}"
        wx:key="id"
        class="review-item"
      >
        <view class="review-item__info">
          <view class="review-item__name">{{ item.name }}</view>
          <view class="review-item__detail" wx:if="{{ item.phoneNum || item.remark }}">
            <text class="label">手机号：</text>
            <text class="value">{{ item.phoneNum || item.remark }}</text>
          </view>
          <view class="review-item__detail" wx:if="{{ item.signatureImei }}">
            <text class="label">签约IMEI：</text>
            <text class="value">{{ item.signatureImei }}</text>
          </view>
          <view class="review-item__detail" wx:if="{{ item.createTime }}">
            <text class="label">提交时间：</text>
            <text class="value">{{ item.createTime }}</text>
          </view>
        </view>

        <view class="review-item__actions">
          <van-button
            size="small"
            round
            type="danger"
            plain
            loading="{{ isOperating }}"
            data-index="{{ index }}"
            data-action="reject"
            bind:click="handleReview"
            custom-style="margin-bottom: 12rpx;"
          >
            驳回
          </van-button>
          <van-button
            size="small"
            round
            type="primary"
            loading="{{ isOperating }}"
            data-index="{{ index }}"
            data-action="approve"
            bind:click="handleReview"
          >
            通过
          </van-button>
        </view>
      </view>
    </view>

    <!-- 空态 -->
    <view wx:else class="empty-state">
      <van-icon name="orders-o" size="48" color="#c8c9cc" />
      <view class="empty-text">暂无待审核订单</view>
    </view>

    <!-- 加载更多 -->
    <view wx:if="{{ loadingMore }}" class="loading-more">
      <van-loading type="spinner" color="#1989fa" size="16px">加载更多...</van-loading>
    </view>
  </block>

  <!-- 金额输入弹窗 -->
  <view wx:if="{{ showAmountDialog }}" class="amount-dialog-overlay" catchtouchmove="{{ true }}">
    <view class="amount-dialog">
      <view class="amount-dialog__title">请输入赔付金额</view>
      <view class="amount-dialog__input-wrap">
        <text class="amount-dialog__prefix">¥</text>
        <input
          class="amount-dialog__input"
          type="digit"
          placeholder="0.00"
          value="{{ amountInput }}"
          bindinput="handleAmountInput"
          focus="{{ true }}"
        />
      </view>
      <view class="amount-dialog__actions">
        <van-button size="small" round plain bindtap="handleCloseAmountDialog">取消</van-button>
        <van-button size="small" round type="primary" bindtap="handleAmountConfirm">确定</van-button>
      </view>
    </view>
  </view>
</view>
