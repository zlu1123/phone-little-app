/* pages/contract-sign/contract-sign.wxss */
/* 遵循 Vant Weapp 设计规范 */

.contract-sign-page {
  height: 100vh;
  background: #f7f8fa;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ========== 自定义导航栏 ========== */
.nav-header {
  width: 100%;
  background: #fff;
  border-bottom: 1rpx solid #ebedf0;
  box-sizing: border-box;
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-bar {
  position: relative;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-btn {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  z-index: 1;
}

.back-btn:active {
  opacity: 0.6;
}

.back-arrow {
  font-size: 36rpx;
  color: #323233;
  margin-right: 8rpx;
  font-weight: 500;
  line-height: 1;
}

.back-text {
  font-size: 28rpx;
  color: #323233;
  line-height: 1;
}

.page-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #323233;
  text-align: center;
}

.nav-placeholder {
  display: none;
}

/* ========== 阶段1：查看协议 ========== */
.contract-section {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: #f7f8fa;
}

.contract-section .nav-header {
  flex-shrink: 0;
}

/* 协议信息卡片样式已废弃（页面不再展示卡片） */

/* ========== 协议正文（富文本） ========== */
.contract-card {
  flex: 1;
  margin: 24rpx 32rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.contract-scroll-view {
  flex: 1;
  height: 100%;
}

.contract-content-inner {
  padding: 32rpx;
  box-sizing: border-box;
}

.contract-rich-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.8;
  color: #323233;
  /* 小屏兑底：连续下划线 / 长URL / 长英文单词都强制可断行 */
  word-break: break-word;
  word-wrap: break-word;
  overflow-wrap: anywhere;
}

/* 富文本内常见块级元素统一防溢出（针对后端返回 HTML 小屏适配） */
.contract-rich-text div,
.contract-rich-text span,
.contract-rich-text section,
.contract-rich-text article {
  max-width: 100%;
  word-break: break-word;
  overflow-wrap: anywhere;
  box-sizing: border-box;
}

/* 富文本子标签样式（rich-text 内部节点） */
.contract-rich-text h1,
.contract-rich-text h2 {
  font-size: 34rpx;
  font-weight: 600;
  color: #1d1f23;
  margin: 32rpx 0 16rpx;
  line-height: 1.4;
}

.contract-rich-text h3 {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1f23;
  margin: 28rpx 0 14rpx;
  line-height: 1.4;
}

.contract-rich-text h4,
.contract-rich-text h5,
.contract-rich-text h6 {
  font-size: 28rpx;
  font-weight: 600;
  color: #1d1f23;
  margin: 24rpx 0 12rpx;
  line-height: 1.4;
}

.contract-rich-text p {
  margin: 12rpx 0;
  font-size: 28rpx;
  line-height: 1.8;
  color: #323233;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.contract-rich-text strong,
.contract-rich-text b {
  font-weight: 600;
  color: #1d1f23;
}

.contract-rich-text em,
.contract-rich-text i {
  font-style: italic;
}

.contract-rich-text ul,
.contract-rich-text ol {
  padding-left: 40rpx;
  margin: 12rpx 0;
}

.contract-rich-text li {
  margin: 6rpx 0;
  font-size: 28rpx;
  line-height: 1.8;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.contract-rich-text a {
  color: #1989fa;
  text-decoration: underline;
  word-break: break-all;
}

.contract-rich-text img {
  max-width: 100%;
  height: auto;
  display: block;
  margin: 16rpx 0;
}

.contract-rich-text blockquote {
  margin: 16rpx 0;
  padding: 16rpx 24rpx;
  border-left: 6rpx solid #dcdee0;
  background: #f7f8fa;
  color: #646566;
  font-size: 26rpx;
}

/* 表格：小屏下采用「可横向滚动 + 强制断词」双保险，避免表格表单（如设备型号/IMEI 填空行）错位 */
.contract-rich-text table {
  /* 不设 table-layout:fixed，避免下划线填空被压缩 */
  width: 100%;
  max-width: 100%;
  border-collapse: collapse;
  margin: 16rpx 0;
  font-size: 26rpx;
  /* 如果表格本身超宽，允许内部横滚不冲破外层 */
  display: block;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.contract-rich-text tbody,
.contract-rich-text thead,
.contract-rich-text tr {
  width: 100%;
}

.contract-rich-text th,
.contract-rich-text td {
  border: 1rpx solid #ebedf0;
  padding: 12rpx 16rpx;
  text-align: left;
  vertical-align: top;
  /* 下划线填空不会被作为一个完整词裂顶单元格，而是允许任意位置换行 */
  word-break: break-all;
  overflow-wrap: anywhere;
  white-space: normal;
}

.contract-rich-text th {
  background: #f7f8fa;
  font-weight: 600;
}

/* 小屏兑底：pre / code 块也允许折行 */
.contract-rich-text pre,
.contract-rich-text code {
  white-space: pre-wrap;
  word-break: break-word;
  overflow-wrap: anywhere;
  max-width: 100%;
}

/* 「请滑动至底」提示行（仅未滑到底时显示） */
.scroll-tips {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #969799;
  padding: 16rpx 0 4rpx;
  flex-shrink: 0;
}

/* 状态提示（旧） */
.countdown-tips,
.success-tips,
.default-tips {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  margin-top: 8rpx;
}

.countdown-tips {
  color: #ff976a;
}

.success-tips {
  color: #07c160;
}

.default-tips {
  color: #969799;
}

/* 底部操作栏：取消靠左、确认靠右 */
.contract-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #ebedf0;
  flex-shrink: 0;
}

.contract-footer .van-button {
  margin: 0;
  /* 让两个按钮各占约 44%，中间留出空白形成「左右两端对齐」视觉 */
  flex: 0 1 44%;
  min-width: 220rpx;
}

.btn-cancel {
  /* 保留 class hook，宽度由 .contract-footer .van-button 统一控制 */
}

.btn-confirm {
  /* 保留 class hook，宽度由 .contract-footer .van-button 统一控制 */
}

/* ========== 阶段2：手写签名 ========== */
.signature-section {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: #f7f8fa;
}

.signature-section .nav-header {
  flex-shrink: 0;
}

.signature-header {
  margin: 32rpx 32rpx 0;
  text-align: center;
}

.signature-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #323233;
}

.signature-subtitle {
  font-size: 26rpx;
  color: #969799;
  margin-top: 12rpx;
}

/* 签名画布容器 */
.signature-canvas-wrapper {
  position: relative;
  flex: 1;
  margin: 32rpx;
  min-height: 600rpx; /* 竖屏下增加画布高度 */
  background: #fff;
  border: 2rpx dashed #dcdee0;
  border-radius: 16rpx;
  overflow: hidden;
}

.signature-canvas {
  width: 100%;
  height: 100%;
}

/* 横屏适配：屏幕较扁时收紧上下间距，让画布占据更多有效空间 */
@media (orientation: landscape) {
  .signature-section {
    /* 横屏时不再强制最少 100vh（已满），用 100% 即可避免底部按钮被挤出视口 */
    height: 100%;
  }
  .signature-header {
    margin: 16rpx 32rpx 0;
  }
  .signature-title {
    font-size: 32rpx;
  }
  .signature-subtitle {
    font-size: 22rpx;
    margin-top: 4rpx;
  }
  .signature-canvas-wrapper {
    margin: 16rpx 32rpx;
    /* 横屏下放低最小高度门槛，让 flex:1 能真正自适应 */
    min-height: 160rpx;
  }
  .signature-footer {
    padding: 12rpx 32rpx;
    padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  }
}

.signature-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #dcdee0;
  font-size: 30rpx;
  pointer-events: none;
}

/* 签名底部操作栏 */
.signature-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #ebedf0;
  flex-shrink: 0;
}

.signature-footer .van-button {
  margin: 0;
  flex: 0 1 44%;
  min-width: 220rpx;
}

/* ========== 阶段2：设备信息填写 ========== */
.device-info-section {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: #f7f8fa;
}

.device-info-section .nav-header {
  flex-shrink: 0;
}

.device-info-header {
  margin: 32rpx 32rpx 0;
  text-align: center;
}

.device-info-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #323233;
}

.device-info-subtitle {
  font-size: 26rpx;
  color: #969799;
  margin-top: 12rpx;
}

.device-info-form {
  flex: 1;
  margin: 32rpx 0 0;
  overflow-y: auto;
}

.device-info-tips {
  margin: 16rpx 32rpx 0;
  font-size: 24rpx;
  color: #969799;
  line-height: 1.6;
}

.device-info-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #ebedf0;
  flex-shrink: 0;
}

.device-info-footer .van-button {
  margin: 0;
  flex: 0 1 44%;
  min-width: 220rpx;
}

.device-info-footer .btn-cancel {
  /* 保留 class hook，宽度由 .device-info-footer .van-button 统一控制 */
}

.device-info-footer .btn-confirm {
  /* 保留 class hook，宽度由 .device-info-footer .van-button 统一控制 */
}
