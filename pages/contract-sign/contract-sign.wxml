<!--pages/contract-sign/contract-sign.wxml-->
<view class="contract-sign-page">
  <!-- ===== 阶段1：查看协议 ===== -->
  <view wx:if="{{ stage === 'contract' }}" class="contract-section">
    <!-- 导航栏 -->
    <van-nav-bar
      title="协议签署"
      left-text="返回"
      left-arrow
      safe-area-inset-top
      bind:click-left="handleCloseContract"
    />

    <!-- 协议正文（HTML 富文本，由后端 content 字段返回） -->
    <view wx:if="{{ contractLoaded && contractContent }}" class="contract-card">
      <scroll-view
        class="contract-scroll-view"
        scroll-y
        enhanced
        show-scrollbar="{{ true }}"
        lower-threshold="{{ 20 }}"
        bindscrolltolower="handleContentScrollToLower"
      >
        <view class="contract-content-inner">
          <rich-text class="contract-rich-text" nodes="{{ contractContent }}" space="nbsp" />
        </view>
      </scroll-view>
    </view>

    <!-- 阅读状态提示（仅在倒计时结束但仍未滑到底时显示，倒计时本身已展示在按钮上） -->
    <view wx:if="{{ contractLoaded && !contractCanConfirm && contractCountdown <= 0 && !contractScrolledToBottom }}" class="scroll-tips">
      <text>请滑动至协议底部以继续</text>
    </view>

    <!-- 底部操作栏（协议加载完成后才展示） -->
    <view wx:if="{{ contractLoaded }}" class="contract-footer">
      <van-button
        class="btn-cancel"
        round
        size="normal"
        plain
        type="default"
        bind:click="handleCloseContract"
      >
        取消
      </van-button>
      <van-button
        class="btn-confirm"
        round
        size="normal"
        type="primary"
        disabled="{{ !contractCanConfirm }}"
        bind:click="handleContractConfirm"
      >
        我已阅读并同意{{ contractCountdown > 0 ? '（' + contractCountdown + 's）' : '' }}
      </van-button>
    </view>
  </view>

  <!-- ===== 阶段2：填写设备信息（SN / IMEI / 手机型号）===== -->
  <view wx:if="{{ stage === 'device-info' }}" class="device-info-section">
    <!-- 导航栏 -->
    <van-nav-bar
      title="填写设备信息"
      left-text="返回"
      left-arrow
      safe-area-inset-top
      bind:click-left="handleBackToContract"
    />

    <view class="device-info-header">
      <view class="device-info-title">请填写新设备信息</view>
      <view class="device-info-subtitle">IMEI 与 SN 至少填写一项，手机型号必填</view>
    </view>

    <view class="device-info-form">
      <van-cell-group inset>
        <van-field
          label="IMEI"
          value="{{ deviceForm.imei }}"
          placeholder="请输入 IMEI（14-17 位数字）"
          type="number"
          clearable
          maxlength="17"
          input-align="left"
          data-field="imei"
          bind:change="handleDeviceFieldChange"
        />
        <van-field
          label="SN"
          value="{{ deviceForm.sn }}"
          placeholder="请输入设备 SN（与 IMEI 二选一）"
          clearable
          maxlength="32"
          input-align="left"
          data-field="sn"
          bind:change="handleDeviceFieldChange"
        />
        <van-field
          label="手机型号"
          value="{{ deviceForm.phoneModel }}"
          placeholder="请输入手机型号"
          required
          clearable
          maxlength="50"
          input-align="left"
          data-field="phoneModel"
          bind:change="handleDeviceFieldChange"
        />
      </van-cell-group>
      <view class="device-info-tips">
        <text>* IMEI 与 SN 至少填写一项；提交后此信息将作为协议签订记录，请仔细核对</text>
      </view>
    </view>
    <!-- 底部操作栏 -->
    <view class="device-info-footer">
      <van-button
        class="btn-cancel"
        round
        size="normal"
        plain
        type="default"
        bind:click="handleBackToContract"
      >
        上一步
      </van-button>
      <van-button
        class="btn-confirm"
        round
        size="normal"
        type="primary"
        bind:click="handleDeviceInfoNext"
      >
        下一步
      </van-button>
    </view>
  </view>

  <!-- ===== 阶段3：手写签名 ===== -->
  <view wx:if="{{ stage === 'signature' }}" class="signature-section">
    <!-- 导航栏 -->
    <van-nav-bar
      title="手写签名"
      left-text="返回"
      left-arrow
      safe-area-inset-top
      bind:click-left="handleCancelSignature"
    />

    <view class="signature-header">
      <view class="signature-title">请手写签名</view>
      <view class="signature-subtitle">请在下方区域手写您的签名</view>
    </view>

    <!-- 签名画布 -->
    <view class="signature-canvas-wrapper">
      <canvas
        id="signature-canvas"
        type="2d"
        class="signature-canvas"
        disable-scroll="{{true}}"
        bindtouchstart="handleSignatureStart"
        bindtouchmove="handleSignatureMove"
        bindtouchend="handleSignatureEnd"
      />
      <view wx:if="{{ !hasSigned }}" class="signature-placeholder">
        <text>请在此处签名</text>
      </view>
    </view>

    <!-- 底部操作栏 -->
    <view class="signature-footer">
      <van-button
        class="btn-clear"
        round
        size="normal"
        plain
        type="warning"
        bind:click="handleClearSignature"
      >
        清除重写
      </van-button>
      <van-button
        class="btn-confirm"
        round
        size="normal"
        type="primary"
        loading="{{ uploadingSignature }}"
        loading-text="上传中..."
        disabled="{{ !hasSigned || uploadingSignature }}"
        bind:click="handleConfirmSignature"
      >
        确认签名
      </van-button>
    </view>
  </view>

  <!-- ===== 阶段4：签署成功 ===== -->
  <view wx:if="{{ stage === 'success' }}" class="success-section">
    <!-- 成功内容 -->
    <view class="success-body">
      <view class="success-icon-wrapper">
        <van-icon name="passed" size="96rpx" color="#07c160" />
      </view>

      <view class="success-title">签署成功</view>
      <view class="success-subtitle">协议已成功签署，感谢您的使用</view>

      <view class="success-actions">
        <van-button
          wx:if="{{ redirectToYaDing }}"
          class="btn-go-yading"
          round
          block
          bind:click="handleOpenYaDing"
          icon="wechat"
          color="linear-gradient(to right, #07c160, #06ad56)"
        >
          前往亚丁屏卫
        </van-button>
        <van-button
          class="btn-go-home"
          round
          block
          type="primary"
          bind:click="handleGoHome"
        >
          返回首页
        </van-button>
        <van-button
          class="btn-view-order"
          round
          block
          plain
          type="primary"
          bind:click="handleViewOrder"
        >
          查看本次订单
        </van-button>
      </view>
    </view>

    <!-- 底部tabbar（保持与全局tabbar一致） -->
    <van-tabbar
      active="{{ successTabActive }}"
      active-color="#1989fa"
      inactive-color="#7d7e80"
      bind:change="handleSuccessTabChange"
    >
      <van-tabbar-item wx:for="{{ successTabList }}" wx:key="index" icon="{{ item.icon }}">
        {{ item.text }}
      </van-tabbar-item>
    </van-tabbar>
  </view>

  <!-- 公众号引导弹窗（仅在用户点击按钮后展示） -->
  <van-popup
    wx:if="{{ stage === 'success' && showOAModal }}"
    show="{{ showOAModal }}"
    round
    closeable
    close-icon="cross"
    custom-class="oa-modal"
    lock-scroll="{{ true }}"
    overlay="{{ true }}"
    bind:close="handleCloseOAModal"
    bind:click-overlay="handleCloseOAModal"
    catch:touchmove="handleNoop"
  >
    <view class="oa-modal__inner" catch:tap="handleNoop" catch:touchmove="handleNoop">
      <view class="oa-modal__header">
        <view class="oa-modal__icon">
          <van-icon name="wechat" size="48" color="#07c160" />
        </view>
        <view class="oa-modal__title">扫码关注「亚丁屏卫」</view>
        <view class="oa-modal__subtitle">长按二维码识别，立即享受保修服务</view>
      </view>
      <view class="oa-qrcode-wrapper">
        <image
          class="oa-qrcode-image"
          src="/images/yading-qrcode.png"
          mode="aspectFit"
          show-menu-by-longpress="{{ true }}"
          aria-label="亚丁屏卫公众号二维码"
        />
      </view>
      <view class="oa-modal__tip">
        <van-icon name="info-o" size="14" color="#969799" />
        <text>长按图片可保存二维码到相册</text>
      </view>
    </view>
  </van-popup>
</view>
