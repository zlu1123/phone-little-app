<view class="login-page">
  <!-- 状态栏占位 -->
  <view style="height: {{ statusBarHeight }}px;"></view>

  <!-- Logo 区域 -->
  <view class="logo-section">
    <view class="logo-wrapper">
      <van-icon name="scan" size="60px" color="#1989fa" />
    </view>
  </view>

  <!-- 登录/注册切换 Tab (暂时隐藏注册入口) -->
  <!--
  <view class="auth-tabs">
    <view
      class="tab-item {{ mode === 'login' ? 'active' : '' }}"
      bindtap="handleSwitchMode"
      data-mode="login"
    >
      <text>登录</text>
      <view class="tab-line" wx:if="{{ mode === 'login' }}"></view>
    </view>
    <view
      class="tab-item {{ mode === 'register' ? 'active' : '' }}"
      bindtap="handleSwitchMode"
      data-mode="register"
    >
      <text>注册</text>
      <view class="tab-line" wx:if="{{ mode === 'register' }}"></view>
    </view>
  </view>
  -->

  <!-- 手机号密码登录 -->
  <view class="login-section">
    <view class="phone-form">
      <van-field
        value="{{ account }}"
        maxlength="30"
        placeholder="请输入手机号或用户名"
        border="{{ false }}"
        bind:change="handleAccountChange"
        class="input-field"
      >
        <van-icon slot="left-icon" name="user-o" size="18px" color="#969799" custom-style="margin-right: 16rpx;" />
      </van-field>

      <van-field
        value="{{ password }}"
        type="password"
        maxlength="20"
        placeholder="请输入密码"
        border="{{ false }}"
        bind:change="handlePasswordChange"
        class="input-field"
      >
        <van-icon slot="left-icon" name="lock" size="18px" color="#969799" custom-style="margin-right: 16rpx;" />
      </van-field>

      <van-button
        type="primary"
        block
        round
        loading="{{ isLoading }}"
        disabled="{{ !account || !password || !agreed }}"
        bind:click="handlePasswordLogin"
        class="submit-btn"
      >
        登录
      </van-button>
    </view>

    <!-- 协议勾选 -->
    <view class="agreement-section">
      <van-checkbox value="{{ agreed }}" bind:change="handleAgreementChange" shape="square" class="agreement-checkbox">
        我已阅读并同意
      </van-checkbox>
      <text class="agreement-link" bindtap="handleViewAgreement" data-type="user">《用户服务协议》</text>
      <text>和</text>
      <text class="agreement-link" bindtap="handleViewAgreement" data-type="privacy">《隐私政策》</text>
    </view>
  </view>
</view>
