<view class="login-page">
  <!-- 状态栏占位 -->
  <view style="height: {{ statusBarHeight }}px;"></view>

  <!-- Logo 区域 -->
  <view class="logo-section">
    <view class="logo-wrapper">
      <van-icon name="scan" size="60px" color="#1989fa" />
    </view>
  </view>

  <!-- 登录/注册切换 Tab -->
  <view class="auth-tabs">
    <view
      class="tab-item {{ mode === 'login' ? 'active' : '' }}"
      bindtap="handleSwitchMode"
      data-mode="login"
    >
      <text>登录</text>
      <view class="tab-line" wx:if="{{ mode === 'login' }}"></view>
    </view>
    <view
      class="tab-item {{ mode === 'register' ? 'active' : '' }}"
      bindtap="handleSwitchMode"
      data-mode="register"
    >
      <text>注册</text>
      <view class="tab-line" wx:if="{{ mode === 'register' }}"></view>
    </view>
  </view>

  <!-- 登录模式 -->
  <view class="login-section" wx:if="{{ mode === 'login' }}">
    <!-- 微信一键登录 -->
    <button
      class="login-btn wechat-btn"
      open-type="getUserInfo"
      bindgetuserinfo="handleWechatLogin"
    >
      <van-icon name="wechat" size="20px" color="#fff" />
      <text class="btn-text">微信一键登录</text>
    </button>

    <!-- 手机号登录 -->
    <button
      class="login-btn phone-btn"
      open-type="getPhoneNumber"
      bindgetphonenumber="handlePhoneLogin"
    >
      <van-icon name="phone-o" size="20px" color="#1989fa" />
      <text class="btn-text">手机号快捷登录</text>
    </button>

    <!-- 分隔线 -->
    <view class="divider">
      <view class="line"></view>
      <text class="divider-text">或</text>
      <view class="line"></view>
    </view>

    <!-- 手动输入手机号密码登录 -->
    <view class="phone-form" wx:if="{{ showPhoneForm }}">
      <van-field
        value="{{ phone }}"
        type="number"
        maxlength="11"
        placeholder="请输入手机号"
        border="{{ false }}"
        bind:change="handlePhoneChange"
        class="input-field"
      >
        <van-icon slot="left-icon" name="phone-o" size="18px" color="#969799" />
      </van-field>

      <van-field
        value="{{ password }}"
        type="password"
        maxlength="20"
        placeholder="请输入密码"
        border="{{ false }}"
        bind:change="handlePasswordChange"
        class="input-field"
      >
        <van-icon slot="left-icon" name="lock" size="18px" color="#969799" />
      </van-field>

      <van-button
        type="primary"
        block
        round
        loading="{{ isLoading }}"
        disabled="{{ !phone || !password }}"
        bind:click="handlePasswordLogin"
        class="submit-btn"
      >
        登录
      </van-button>
    </view>

    <!-- 切换手动输入 -->
    <view class="toggle-form" bindtap="togglePhoneForm">
      <text>{{ showPhoneForm ? '收起手机号登录' : '使用手机号密码登录' }}</text>
      <van-icon name="{{ showPhoneForm ? 'arrow-up' : 'arrow-down' }}" size="12px" />
    </view>
  </view>

  <!-- 注册模式 -->
  <view class="login-section" wx:if="{{ mode === 'register' }}">
    <!-- 微信手机号注册 -->
    <button
      class="login-btn phone-btn"
      open-type="getPhoneNumber"
      bindgetphonenumber="handleWechatPhoneRegister"
    >
      <van-icon name="wechat" size="20px" color="#1989fa" />
      <text class="btn-text">微信手机号快捷注册</text>
    </button>

    <!-- 分隔线 -->
    <view class="divider">
      <view class="line"></view>
      <text class="divider-text">或</text>
      <view class="line"></view>
    </view>

    <!-- 手动输入手机号密码注册表单 -->
    <view class="phone-form">
      <van-field
        value="{{ registerPhone }}"
        type="number"
        maxlength="11"
        placeholder="请输入手机号"
        border="{{ false }}"
        bind:change="handleRegisterPhoneChange"
        class="input-field"
      >
        <van-icon slot="left-icon" name="phone-o" size="18px" color="#969799" />
      </van-field>

      <van-field
        value="{{ registerPassword }}"
        type="password"
        maxlength="20"
        placeholder="请输入密码（6-20位）"
        border="{{ false }}"
        bind:change="handleRegisterPasswordChange"
        class="input-field"
      >
        <van-icon slot="left-icon" name="lock" size="18px" color="#969799" />
      </van-field>

      <van-field
        value="{{ confirmPassword }}"
        type="password"
        maxlength="20"
        placeholder="请确认密码"
        border="{{ false }}"
        bind:change="handleConfirmPasswordChange"
        class="input-field"
      >
        <van-icon slot="left-icon" name="lock" size="18px" color="#969799" />
      </van-field>

      <van-button
        type="primary"
        block
        round
        loading="{{ isLoading }}"
        disabled="{{ !registerPhone || !registerPassword || !confirmPassword }}"
        bind:click="handleRegister"
        class="submit-btn"
      >
        注册
      </van-button>
    </view>

    <!-- 已有账号提示 -->
    <view class="toggle-form" bindtap="handleSwitchMode" data-mode="login">
      <text>已有账号？去登录</text>
      <van-icon name="arrow" size="12px" />
    </view>
  </view>

  <!-- 游客模式 -->
  <view class="guest-entry" bindtap="handleGuestLogin">
    <text>暂不登录，先逛逛</text>
  </view>
</view>
