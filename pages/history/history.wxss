.history-page {
  min-height: 100vh;
  background-color: #f7f8fa;
}

.scroll-container {
  height: calc(100vh - 46px);
}

.loading-container,
.empty-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60vh;
}

.list-container {
  padding: 12px;
  padding-bottom: calc(20px + env(safe-area-inset-bottom));
}

.order-item {
  background-color: #fff;
  border-radius: 8px;
  padding: 16px;
  margin-bottom: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
  padding-bottom: 12px;
  border-bottom: 1px solid #ebedf0;
}

.order-time {
  font-size: 14px;
  color: #969799;
}

.tag-group {
  display: flex;
  gap: 8px;
  align-items: center;
}

.order-content {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.info-row {
  display: flex;
  font-size: 14px;
  line-height: 20px;
}

.label {
  color: #646566;
  width: 70px;
  flex-shrink: 0;
}

.value {
  color: #323233;
  flex: 1;
  word-break: break-all;
}

/* 上拉加载更多 */
.load-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 16px 0;
}

.no-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 16px 0;
  color: #969799;
  font-size: 13px;
}
