<view class="history-page">
  <van-nav-bar
    title="查询记录"
    left-arrow
    bind:click-left="onClickLeft"
    fixed="{{true}}"
    placeholder="{{true}}"
    z-index="{{100}}"
  />

  <scroll-view
    class="scroll-container"
    scroll-y
    refresher-enabled
    refresher-triggered="{{isRefreshing}}"
    bindrefresherrefresh="onRefresh"
    bindscrolltolower="onScrollToLower"
    lower-threshold="100"
  >
    <view wx:if="{{ isLoading }}" class="loading-container">
      <van-loading type="spinner" color="#1989fa" />
    </view>

    <view wx:elif="{{ orderList.length === 0 }}" class="empty-container">
      <van-empty description="暂无查询记录" />
    </view>

    <view wx:else class="list-container">
      <view class="order-item" wx:for="{{ orderList }}" wx:key="id">
        <view class="order-header">
          <text class="order-time">{{ item.createTime }}</text>
          <van-tag type="{{ item.activated ? (item.isExpired ? 'danger' : 'success') : 'warning' }}">
            {{ item.warrantyStatus }}
          </van-tag>
        </view>

        <view class="order-content">
          <view class="info-row">
            <text class="label">设备型号：</text>
            <text class="value">{{ item.model || '未知' }}</text>
          </view>
          <view class="info-row">
            <text class="label">序列号：</text>
            <text class="value">{{ item.sn || '未知' }}</text>
          </view>
          <view class="info-row" wx:if="{{ item.imei1 }}">
            <text class="label">IMEI1：</text>
            <text class="value">{{ item.imei1 }}</text>
          </view>
          <view class="info-row" wx:if="{{ item.imei2 }}">
            <text class="label">IMEI2：</text>
            <text class="value">{{ item.imei2 }}</text>
          </view>
          <view class="info-row" wx:if="{{ item.activated }}">
            <text class="label">激活时间：</text>
            <text class="value">{{ item.activateDate || '未知' }}</text>
          </view>
          <view class="info-row" wx:if="{{ item.activated && item.coverage }}">
            <text class="label">保修截止：</text>
            <text class="value">{{ item.coverage }}</text>
          </view>
        </view>
      </view>

      <!-- 上拉加载更多 -->
      <view class="load-more" wx:if="{{ loadingMore }}">
        <van-loading type="spinner" color="#1989fa" size="20px">加载中...</van-loading>
      </view>
      <view class="load-more finished-text" wx:elif="{{ finished }}">
        <text>— 没有更多了 —</text>
      </view>
    </view>
  </scroll-view>
</view>
