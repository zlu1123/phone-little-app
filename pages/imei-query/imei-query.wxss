/* pages/imei-query/imei-query.wxss */
/* 修复页面无法滚动的问题 */
page {
  height: auto !important;
  overflow-y: auto !important;
  display: block !important;
}

.imei-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #eef3fb 0%, #f7f8fa 40%);
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.steps-wrapper {
  background-color: #fff;
  padding: 12px 0;
  margin-bottom: 20px;
  box-shadow: 0 1px 6px rgba(25, 137, 250, 0.06);
}

.content-container {
  padding: 0 20px;
}

/* 卡片区域 */
.card-section {
  background: #fff;
  border-radius: 16px;
  padding: 24px 20px;
  margin-bottom: 20px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
  animation: fadeIn 0.5s ease;
}

.section-header {
  margin-bottom: 24px;
  border-left: 8rpx solid #1989fa;
  padding-left: 20rpx;
}

.section-header .title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.3;
}

.section-header .subtitle {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* ========== 图片预览区域（自定义大图） ========== */
.preview-wrapper {
  width: 100%;
}

.preview-image-box {
  position: relative;
  width: 100%;
  border-radius: 24rpx;
  overflow: hidden;
  background-color: #f5f7fa;
  border: 2rpx solid #ebedf0;
}

/* van-image 组件内部样式穿透 */
.preview-image-box .van-image {
  display: block;
  width: 100% !important;
}

.preview-delete-btn {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 48rpx;
  height: 48rpx;
  background: rgba(0, 0, 0, 0.55);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.preview-delete-btn:active {
  background: rgba(0, 0, 0, 0.75);
}

/* ========== 手机型号选择（步骤1） ========== */
.model-select-wrapper {
  margin-bottom: 24rpx;
}

.model-select-group {
  margin: 0 !important;
}

/* ========== 上传组件样式 ========== */
.upload-wrapper {
  margin: 20rpx 0;
  width: 100%;
  display: flex;
  justify-content: center;
}

.custom-uploader {
  width: 100%;
  display: block;
}

.custom-uploader .van-uploader {
  width: 100%;
}

.custom-uploader .van-uploader__wrapper {
  width: 100%;
  display: flex;
  justify-content: center;
}

.custom-uploader .van-uploader__input-wrapper {
  width: 100%;
  display: flex;
  justify-content: center;
}

/* 自定义上传区域样式 */
.upload-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 400rpx;
  background: linear-gradient(135deg, #f0f7ff 0%, #e8f2ff 100%);
  border: 2rpx dashed #1989fa;
  border-radius: 24rpx;
  transition: all 0.3s;
  box-sizing: border-box;
  padding: 40rpx;
}

.upload-area:active {
  background: linear-gradient(135deg, #e0edff 0%, #d6e8ff 100%);
  border-color: #0570db;
  transform: scale(0.98);
}

.upload-icon-wrapper {
  width: 128rpx;
  height: 128rpx;
  background: rgba(25, 137, 250, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.upload-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
  margin-bottom: 12rpx;
}

.upload-hint {
  font-size: 24rpx;
  color: #999;
}

/* 加载中 */
.loading-wrapper {
  margin-top: 32rpx;
  text-align: center;
  padding: 32rpx;
  background: #f7f9fc;
  border-radius: 16rpx;
}

/* ========== 表单样式 ========== */
.form-group {
  margin-bottom: 32rpx;
}

.action-btn {
  margin-top: 40rpx;
}

.mb-3 {
  margin-bottom: 24rpx;
}

/* 跳转公众号按钮样式 */
.jump-btn {
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.35) !important;
  font-weight: 600 !important;
  letter-spacing: 2rpx;
}

/* ========== 结果展示样式 ========== */
.result-content {
  background: linear-gradient(135deg, #f8fafe 0%, #f2f6fc 100%);
  border-radius: 20rpx;
  padding: 16rpx 32rpx;
  margin-bottom: 40rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #eef1f5;
}

.info-item:last-child {
  border-bottom: none;
}

.info-item .label {
  color: #666;
  font-size: 28rpx;
}

.info-item .value {
  color: #1a1a1a;
  font-weight: 500;
  font-size: 30rpx;
  line-height: 1.4;
}

.text-danger {
  color: #ee0a24;
  font-size: 30rpx;
  line-height: 1.4;
}

.text-success {
  color: #07c160;
  font-size: 30rpx;
  line-height: 1.4;
}

.tip-text {
  font-size: 24rpx;
  color: #999;
  margin-top: 24rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

/* ========== 动画 ========== */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
