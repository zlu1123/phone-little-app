<!--pages/imei-query/imei-query.wxml-->
<view class="imei-page">
  <!-- 顶部导航栏 -->
  <van-nav-bar
    title="保修查询助手"
    fixed="{{true}}"
    placeholder="{{true}}"
    z-index="{{100}}"
  ></van-nav-bar>

  <!-- ========== 留资界面：未登记用户信息时显示 ========== -->
  <view wx:if="{{ !leaveInfoCompleted }}" class="leave-info-container">
    <view class="leave-info-card">
      <!-- 头部插图 -->
      <view class="leave-info-header">
        <view class="leave-info-icon">
          <van-icon name="user-o" size="56" color="#1989fa" />
        </view>
        <view class="leave-info-title">请先登记用户信息</view>
        <view class="leave-info-subtitle">登记后即可使用保修查询服务</view>
      </view>

      <!-- 模式切换Tab -->
      <view class="leave-mode-tabs">
        <view
          class="leave-mode-tab {{ showLeaveForm ? 'leave-mode-tab--active' : '' }}"
          bind:tap="handleToggleLeaveMode"
        >
          <text>手动新增</text>
        </view>
        <view
          class="leave-mode-tab {{ !showLeaveForm ? 'leave-mode-tab--active' : '' }}"
          bind:tap="handleToggleLeaveMode"
        >
          <text>搜索选择</text>
        </view>
      </view>

      <!-- 手动新增模式 -->
      <view wx:if="{{ showLeaveForm }}" class="leave-form-section">
        <van-cell-group inset>
          <van-field
            value="{{ leaveName }}"
            label="姓名"
            title-width="4em"
            placeholder="请输入姓名"
            maxlength="20"
            clearable="{{true}}"
            required
            bind:change="handleLeaveNameChange"
          />
          <van-field
            value="{{ leavePhoneNum }}"
            label="手机号"
            title-width="4em"
            placeholder="请输入手机号"
            type="number"
            maxlength="11"
            clearable="{{true}}"
            required
            bind:change="handleLeavePhoneNumChange"
          />
        </van-cell-group>

        <view class="leave-submit-btn">
          <van-button
            round="{{true}}"
            block="{{true}}"
            type="primary"
            loading="{{ isLeaveSubmitting }}"
            loading-text="提交中..."
            bind:click="handleLeaveInfoSubmit"
            color="linear-gradient(to right, #1989fa, #0570db)"
          >
            确认登记
          </van-button>
        </view>
      </view>

      <!-- 搜索选择模式 -->
      <view wx:else class="leave-search-section">
        <view class="leave-search-bar">
          <van-search
            value="{{ leaveSearchContext }}"
            placeholder="输入姓名或手机号搜索"
            show-action
            bind:change="handleLeaveSearchChange"
            bind:search="handleLeaveSearch"
          >
            <view slot="action" bind:tap="handleLeaveSearch">
              <text class="search-action-text">搜索</text>
            </view>
          </van-search>
        </view>

        <!-- 搜索结果列表 -->
        <view wx:if="{{ isLeaveSearching }}" class="leave-list-loading">
          <van-loading type="spinner" color="#1989fa" size="20px">搜索中...</van-loading>
        </view>

        <view wx:elif="{{ leaveUserList.length > 0 }}" class="leave-user-list">
          <view
            wx:for="{{ leaveUserList }}"
            wx:key="*this"
            class="leave-user-item"
            data-index="{{ index }}"
            bind:tap="handleSelectLeaveUser"
            hover-class="leave-user-item--hover"
          >
            <view class="leave-user-avatar">
              <van-icon name="user-o" size="24" color="#1989fa" />
            </view>
            <view class="leave-user-info">
              <view class="leave-user-name">{{ item.name }}</view>
              <view class="leave-user-phone">{{ item.phoneNum }}</view>
            </view>
            <van-icon name="arrow" size="16" color="#969799" />
          </view>
        </view>

        <view wx:elif="{{ leaveUserList.length === 0 && leaveSearchContext }}" class="leave-list-empty">
          <van-icon name="search" size="40" color="#c8c9cc" />
          <view class="empty-text">暂无匹配用户，请尝试其他关键词</view>
        </view>
      </view>
    </view>
  </view>

  <!-- ========== 原有查询功能：留资完成后显示 ========== -->
  <block wx:if="{{ leaveInfoCompleted }}">
  <!-- 已登记用户信息提示条 -->
  <view class="leave-info-bar">
    <view class="leave-info-bar__left">
      <van-icon name="user-o" size="16" color="#1989fa" custom-style="margin-right: 8rpx;" />
      <text class="leave-info-bar__text">{{ leaveName }} {{ leavePhoneNum }}</text>
    </view>
    <view class="leave-info-bar__right" bind:tap="handleBackToLeaveInfo" hover-class="leave-info-bar__right--hover">
      <text>切换</text>
    </view>
  </view>

  <!-- 步骤条 -->
  <view class="steps-wrapper">
    <van-steps steps="{{ steps }}" active="{{ activeStep }}" active-icon="success" active-color="#1989fa" />
  </view>

  <view class="content-container">
    <!-- 步骤1：上传区域 -->
    <view class="card-section">
      <view class="section-header">
        <view class="title">1. 上传设备图片</view>
        <view class="subtitle">请先选择手机型号，再拍摄或上传包含序列号/IMEI的清晰图片</view>
      </view>

      <!-- 手机型号选择（必选） -->
      <view class="model-select-wrapper">
        <van-skeleton title row="1" loading="{{ isFetchingModel }}">
          <van-cell-group inset class="model-select-group">
            <van-field
              value="{{ selectedModelName }}"
              label="手机型号"
              title-width="5em"
              placeholder="请选择手机型号（必选）"
              readonly
              is-link
              required
              bind:click-input="onShowModelPicker"
              bind:click="onShowModelPicker"
              disabled="{{ isRecognizing || activeStep >= 2 }}"
            />
          </van-cell-group>
        </van-skeleton>
      </view>

      <view class="upload-wrapper">
        <van-uploader
          bind:after-read="afterRead"
          bind:delete="onDelete"
          accept="image"
          max-count="1"
          file-list="{{ pictureList }}"
          preview-full-image="{{true}}"
          disabled="{{ isRecognizing || activeStep >= 2 }}"
          deletable="{{ !isRecognizing && activeStep < 2 }}"
          class="custom-uploader"
          use-slot="{{ true }}"
          image-fit="aspectFit"
        >
          <view class="upload-area">
            <view class="upload-icon-wrapper">
              <van-icon name="scan" size="48" color="#1989fa" />
            </view>
            <view class="upload-text">点击拍摄/上传图片</view>
            <view class="upload-hint">自动识别 IMEI 和序列号</view>
          </view>
        </van-uploader>
      </view>

      <!-- 识别加载中 -->
      <view wx:if="{{ isRecognizing }}" class="loading-wrapper">
        <van-loading type="spinner" color="#1989fa" size="24px">正在智能识别中...</van-loading>
      </view>
    </view>

    <!-- 【仅开发/体验环境】调试入口：直接展示「前往亚丁屏卫」，方便测试二维码弹窗 -->
    <!-- <view wx:if="{{ isDev }}" class="dev-entry-card">
      <view class="dev-entry-tag">DEV</view>
      <view
        class="dev-entry-btn"
        hover-class="dev-entry-btn--hover"
        bindtap="handleJumpToOfficialAccount"
        aria-label="测试 - 前往亚丁屏卫"
      >
        <van-icon name="wechat" size="20px" color="#ee0a24" custom-style="margin-right: 12rpx;" />
        <text>🧪 测试 - 前往亚丁屏卫</text>
      </view>
    </view> -->

    <!-- 步骤2：识别结果编辑表单 -->
    <view wx:if="{{ activeStep >= 1 }}" class="card-section">
      <view class="section-header">
        <view class="title">2. 确认设备信息</view>
        <view class="subtitle">系统已自动识别，如有误请手动修改</view>
      </view>

      <van-cell-group inset class="form-group code-form-group">
        <van-field
          value="{{ formData.sn }}"
          label="序列号"
          title-width="4em"
          placeholder="请输入或识别序列号"
          maxlength="20"
          clearable="{{true}}"
          custom-class="code-field"
          input-class="code-field-input"
          bind:change="onSnChange"
        />
        <van-field
          value="{{ formData.imei }}"
          label="IMEI1"
          title-width="4em"
          placeholder="请输入或识别IMEI1"
          type="number"
          maxlength="15"
          clearable="{{true}}"
          custom-class="code-field"
          input-class="code-field-input"
          bind:change="onImeiChange"
        />
        <van-field
          value="{{ formData.imei2 }}"
          label="IMEI2"
          title-width="4em"
          placeholder="请输入或识别IMEI2"
          type="number"
          maxlength="15"
          clearable="{{true}}"
          custom-class="code-field"
          input-class="code-field-input"
          bind:change="onImei2Change"
        />
      </van-cell-group>

      <view class="action-btn">
        <van-button
          round="{{true}}"
          block="{{true}}"
          type="primary"
          bind:click="handleQuery"
          loading="{{ isQuerying }}"
          loading-text="查询中..."
          color="linear-gradient(to right, #1989fa, #0570db)"
        >
          查询保修信息
        </van-button>
      </view>
    </view>

    <!-- 步骤3：查询结果展示 -->
    <view id="step-3-card" wx:if="{{ activeStep >= 2 && queryResult }}" class="card-section result-card">
      <view class="section-header">
        <view class="title">3. 查询结果</view>
        <view class="subtitle">
          <van-tag type="{{ queryResult.isExpired ? 'danger' : 'success' }}" size="medium">
            {{ queryResult.warrantyStatus }}
          </van-tag>
        </view>
      </view>

      <view class="result-content">
        <view class="info-item">
          <text class="label">设备名称</text>
          <text class="value">{{ queryResult.productName }}</text>
        </view>
        <view class="info-item">
          <text class="label">激活时间</text>
          <text class="value">{{ queryResult.activationDate }}</text>
        </view>
        <view class="info-item" wx:if="{{ queryResult.coverageDate && queryResult.coverageDate !== '未知' }}">
          <text class="label">保修截止</text>
          <text class="value">{{ queryResult.coverageDate }}</text>
        </view>
        <view class="info-item">
          <text class="label">保修状态</text>
          <text class="value {{ queryResult.isExpired ? 'text-danger' : 'text-success' }}">
            {{ queryResult.warrantyStatus }}
          </text>
        </view>
      </view>

      <!-- 跳转按钮 -->
      <view class="action-btn">
        <!-- 未过期：显示前往亚丁屏卫 -->
        <van-button
          wx:if="{{ queryResult && !queryResult.isExpired }}"
          round="{{true}}"
          block="{{true}}"
          type="success"
          bind:click="handleJumpToOfficialAccount"
          icon="wechat"
          custom-class="mb-3"
          color="linear-gradient(to right, #07c160, #06ad56)"
        >
          前往亚丁屏卫
        </van-button>

        <!-- 已过期：显示前往签协议 -->
        <van-button
          wx:if="{{ queryResult && queryResult.isExpired }}"
          round="{{true}}"
          block="{{true}}"
          type="warning"
          bind:click="handleShowContract"
          icon="description"
          custom-class="mb-3"
          color="linear-gradient(to right, #ff976a, #ee0a24)"
        >
          前往查看协议并签名
        </van-button>

        <!-- 已签署协议信息展示 -->
        <view wx:if="{{ signedContractInfo }}" class="signed-contract-info mb-3">
          <view class="signed-contract-title">
            <van-icon name="certificate" size="18" color="#07c160" custom-style="margin-right:8rpx;" />
            <text>已签署协议</text>
          </view>
          <view class="signed-contract-detail">
            <text class="contract-name">{{ signedContractInfo.contractName }}</text>
            <text class="contract-version">{{ signedContractInfo.contractVersion }}</text>
          </view>
          <van-button
            size="small"
            plain
            type="primary"
            bind:click="handleViewSignedContract"
            custom-style="margin-top:12rpx;"
          >
            查看已签署协议
          </van-button>
        </view>

        <van-button round="{{true}}" block="{{true}}" plain="{{true}}" type="primary" bind:click="handleReset" icon="replay">
          重新查询
        </van-button>

        <view wx:if="{{ queryResult.isExpired }}" class="tip-text">
          <van-icon name="info-o"></van-icon> 设备已过保，无法享受相关服务
        </view>
      </view>
    </view>
  </view>
<!-- 手机型号选择弹窗 -->
  <van-popup
    show="{{ showModelPicker }}"
    position="bottom"
    bind:close="onCloseModelPicker"
    round
  >
    <van-picker
      show-toolbar
      title="选择手机型号"
      columns="{{ modelOptions }}"
      value-key="name"
      bind:cancel="onCloseModelPicker"
      bind:confirm="onSelectModel"
    />
  </van-popup>

  <!-- 公众号引导弹窗：扫码关注「亚丁屏卫」 -->
  <van-popup
    show="{{ showOAModal }}"
    round
    closeable
    close-icon="cross"
    custom-class="oa-modal"
    lock-scroll="{{ true }}"
    overlay="{{ true }}"
    bind:close="handleCloseOAModal"
    bind:click-overlay="handleCloseOAModal"
    catch:touchmove="handleNoop"
  >
    <view
      class="oa-modal__inner"
      catch:tap="handleNoop"
      catch:touchmove="handleNoop"
    >
      <view class="oa-modal__header">
        <view class="oa-modal__icon">
          <van-icon name="wechat" size="48" color="#07c160" />
        </view>
        <view class="oa-modal__title">扫码关注「亚丁屏卫」</view>
        <view class="oa-modal__subtitle">长按二维码识别，立即享受保修服务</view>
      </view>

      <view class="oa-qrcode-wrapper">
        <image
          class="oa-qrcode-image"
          src="/images/yading-qrcode.png"
          mode="aspectFit"
          show-menu-by-longpress="{{ true }}"
          aria-label="亚丁屏卫公众号二维码"
        />
      </view>

      <view class="oa-modal__tip">
        <van-icon name="info-o" size="14" color="#969799" />
        <text>长按图片可保存二维码到相册</text>
      </view>
    </view>
  </van-popup>
  </block>
</view>
