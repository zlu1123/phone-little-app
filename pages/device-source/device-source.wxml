<!-- pages/device-source/device-source.wxml -->
<view class="ds-page">
  <!-- 顶部导航栏 -->
  <van-nav-bar
    title="保修查询助手"
    left-arrow
    fixed="{{true}}"
    placeholder="{{true}}"
    z-index="{{100}}"
    bind:click-left="handleBack"
  ></van-nav-bar>

  <!-- 留资人信息条 -->
  <van-cell-group inset custom-class="leave-info-group">
    <van-cell title="{{ leaveName }} {{ leavePhoneNum }}" icon="user-o" value="切换" is-link bind:click="handleBackToLeaveInfo" />
  </van-cell-group>

  <!-- 设备来源选择 -->
  <view class="ds-container">
    <view class="ds-card">
      <view class="ds-header">
        <view class="ds-icon">
          <van-icon name="phone-o" size="48" color="#1989fa" />
        </view>
        <view class="ds-title">请选择设备来源</view>
        <view class="ds-subtitle">请确认您当前使用的设备情况</view>
      </view>

      <van-cell-group inset custom-class="ds-cell-group">
        <van-cell
          title="有旧手机（正常）"
          label="我有旧设备，需要查询保修信息"
          is-link
          data-source="has_old"
          bind:click="handleSelectDeviceSource"
        >
          <van-icon slot="icon" name="checked" size="32" color="#07c160" custom-style="margin-right: 20rpx;" />
        </van-cell>
        <van-cell
          title="有旧手机但已损坏/遗失"
          label="旧设备已损坏或丢失，需登记新设备"
          is-link
          data-source="has_old_damaged"
          bind:click="handleSelectDeviceSource"
        >
          <van-icon slot="icon" name="warning-o" size="32" color="#ff976a" custom-style="margin-right: 20rpx;" />
        </van-cell>
        <van-cell
          title="无旧手机"
          label="我没有旧设备，直接去签约"
          is-link
          data-source="no_old"
          bind:click="handleSelectDeviceSource"
        >
          <van-icon slot="icon" name="clear" size="32" color="#ee0a24" custom-style="margin-right: 20rpx;" />
        </van-cell>
        <van-cell
          title="新机对接亚丁"
          label="选择新机机型，无需旧机信息，先签约再对接亚丁"
          is-link
          bind:click="handleOpenModelPicker"
        >
          <van-icon slot="icon" name="gem-o" size="32" color="#1989fa" custom-style="margin-right: 20rpx;" />
        </van-cell>
      </van-cell-group>
    </view>
  </view>

  <!-- 新机机型选择弹层 -->
  <van-popup
    show="{{ showModelPicker }}"
    position="bottom"
    round
    closeable
    close-icon="cross"
    custom-class="model-picker"
    lock-scroll="{{ true }}"
    overlay="{{ true }}"
    bind:close="handleCloseModelPicker"
    bind:click-overlay="handleCloseModelPicker"
    catch:touchmove="handleNoop"
  >
    <view class="model-picker__inner" catch:tap="handleNoop" catch:touchmove="handleNoop">
      <view class="model-picker__title">选择新机机型</view>
      <view class="model-picker__desc">选择后进入签约，手机型号自动带入且可修改；签约完成后按亚丁屏卫流程操作</view>
      <van-cell-group>
        <van-cell
          wx:for="{{ specialModels }}"
          wx:key="model"
          title="{{ item.model }}"
          label="{{ item.desc }}"
          is-link
          data-model="{{ item.model }}"
          bind:click="handlePickModel"
        />
      </van-cell-group>
    </view>
  </van-popup>
</view>
