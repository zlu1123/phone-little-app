.about-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #eef3fb 0%, #f7f8fa 40%);
  padding-bottom: 60rpx;
}

.about-card {
  margin: 40rpx 20rpx;
  padding: 56rpx 32rpx 32rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(25, 137, 250, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.about-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(25, 137, 250, 0.08) 0%, rgba(5, 112, 219, 0.12) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.about-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.about-version {
  font-size: 24rpx;
  color: #969799;
  margin-top: 10rpx;
}

.about-notice {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin: 32rpx 0 8rpx;
  padding: 16rpx 24rpx;
  background: rgba(25, 137, 250, 0.08);
  border-radius: 12rpx;
  width: 100%;
  box-sizing: border-box;
}

.about-notice__text {
  font-size: 24rpx;
  color: #4a6b8a;
  line-height: 1.5;
}

.about-cells {
  width: 100%;
  margin-top: 24rpx;
}
