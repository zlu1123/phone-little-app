.profile-page {
  min-height: 100vh;
  background-color: #f7f8fa;
}

/* 自定义导航栏 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background-color: #1989fa;
  /* 为固定定位的导航栏添加顶部安全距离 */
  padding-top: env(safe-area-inset-top);
}

.nav-bar-inner {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
}

.nav-back {
  width: 40px;
  height: 44px;
  display: flex;
  align-items: center;
}

.nav-title {
  color: #fff;
  font-size: 17px;
  font-weight: bold;
}

.nav-placeholder {
  width: 40px;
}

/* 头部用户信息 */
.profile-header {
  background-color: #1989fa;
  padding: 20px 20px 50px;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #fff;
}

.avatar-container {
  width: 80px;
  height: 80px;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3px solid rgba(255, 255, 255, 0.5);
  overflow: hidden;
  margin-bottom: 12px;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.profile-nickname {
  font-size: 22px;
  font-weight: bold;
  margin-bottom: 4px;
}

.profile-desc {
  font-size: 14px;
  opacity: 0.8;
}

/* 详细信息卡片 */
.detail-card {
  margin-top: -30px;
  position: relative;
  z-index: 1;
}

.detail-card .van-cell-group--inset {
  margin: 0 16px;
  overflow: hidden;
  border-radius: 12px;
  box-shadow: 0 2px 12px rgba(100, 101, 102, 0.08);
}
