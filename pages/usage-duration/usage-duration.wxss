/* pages/usage-duration/usage-duration.wxss */
page {
  height: auto !important;
  overflow-y: auto !important;
  display: block !important;
  padding-top: env(safe-area-inset-top);
  box-sizing: border-box;
}

.ud-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #eef3fb 0%, #f7f8fa 40%);
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.ud-container {
  padding: 40rpx 20rpx;
}

.ud-card {
  width: 100%;
  max-width: 680rpx;
  margin: 0 auto;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(25, 137, 250, 0.08);
}

.ud-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}
.ud-icon {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(
    135deg,
    rgba(255, 151, 106, 0.12) 0%,
    rgba(238, 10, 36, 0.08) 100%
  );
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}
.ud-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}
.ud-subtitle {
  font-size: 26rpx;
  color: #969799;
}

.ud-btns {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.ud-btn {
  margin-bottom: 0 !important;
}

/* OA弹窗 */
.oa-modal {
  width: 600rpx;
  border-radius: 24rpx !important;
  overflow: hidden;
}
.oa-modal__inner {
  padding: 56rpx 32rpx 32rpx;
  background: #fff;
}
.oa-modal__header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}
.oa-modal__icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(7, 193, 96, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}
.oa-modal__title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.3;
}
.oa-modal__subtitle {
  font-size: 26rpx;
  color: #969799;
  margin-top: 12rpx;
}
.oa-qrcode-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: linear-gradient(135deg, #f8fafe 0%, #f2f6fc 100%);
  border-radius: 20rpx;
  margin: 0 8rpx;
}
.oa-qrcode-image {
  width: 380rpx;
  height: 380rpx;
  background: #fff;
  border-radius: 12rpx;
}
.oa-modal__tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 32rpx;
  font-size: 24rpx;
  color: #969799;
}
